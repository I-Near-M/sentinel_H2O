# =========================================================================
# SENTINEL-H2O — VARIABLES DE ENTORNO (PLANTILLA / EJEMPLO)
# Copia este archivo como .env y configura tus credenciales reales
# cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
# 1. ZONA HORARIA Y BASE DE DATOS MYSQL (PERSISTENTE)
# -------------------------------------------------------------------------
TZ=America/Lima
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=sentinel_h2o_db
MYSQL_USER=sentinel_app_user
MYSQL_PASSWORD=your_secure_database_password_here
MYSQL_PORT=3306

# -------------------------------------------------------------------------
# 2. BACKEND API FASTAPI
# -------------------------------------------------------------------------
PROJECT_NAME="Sentinel-H2O Backend API"
VERSION="2.0.0"
ENV=production
BACKEND_PORT=8000
MASTER_API_KEY=your_master_secret_api_key_here
ALLOWED_ORIGINS=["*"]

# -------------------------------------------------------------------------
# 3. METEOROLOGÍA (OPENWEATHERMAP API)
# Obtén tu clave gratuita en: https://openweathermap.org/api
# -------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# -------------------------------------------------------------------------
# 4. MOTOR DE ALERTAS CAMPESINAS (WHATSAPP CLOUD API / TWILIO)
# -------------------------------------------------------------------------
# Proveedor: "meta_cloud", "twilio", o "simulated"
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# Si usas Twilio (Alternativa):
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -------------------------------------------------------------------------
# 5. GRAFANA (SALA DE CONTROL Y GEMELOS VIRTUALES)
# -------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
GRAFANA_ALLOW_SIGNUP=false
GRAFANA_PORT=3000

# -------------------------------------------------------------------------
# 6. FRONTEND WEB APP
# -------------------------------------------------------------------------
WEBAPP_PORT=80
VITE_API_URL=/api/v1
VITE_GRAFANA_URL=http://localhost:3000
