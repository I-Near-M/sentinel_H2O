# =============================================================================
# PROYECTO: SENTINEL-H2O — ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo con el nombre '.env':
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Reemplaza los valores de ejemplo por tus credenciales seguras de producción.
# 3. NUNCA subas el archivo '.env' real a ningún repositorio Git (está en .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENTORNO Y ZONA HORARIA
# -----------------------------------------------------------------------------
TZ=America/Lima
ENV=production
PROJECT_NAME="Sentinel-H2O Platform"
VERSION="2.0.0"

# -----------------------------------------------------------------------------
# 2. BASE DE DATOS MYSQL 8.0 (Persistencia y Telemetría)
# -----------------------------------------------------------------------------
# Contraseña del superusuario root de MySQL (Cámbiala en producción)
MYSQL_ROOT_PASSWORD=cambiar_root_password_segura_2026

# Nombre de la base de datos principal
MYSQL_DATABASE=sentinel_h2o_db

# Usuario dedicado para backend y Grafana
MYSQL_USER=sentinel_user

# Contraseña del usuario dedicado de base de datos
MYSQL_PASSWORD=cambiar_password_segura_usuario_2026

# Puerto expuesto en el Host
MYSQL_PORT=3306

# URL de conexión SQLAlchemy (autogenerada o personalizada)
DATABASE_URL=mysql+pymysql://sentinel_user:cambiar_password_segura_usuario_2026@sentinel-db:3306/sentinel_h2o_db

# -----------------------------------------------------------------------------
# 3. SEGURIDAD, JWT Y CLAVES DE API
# -----------------------------------------------------------------------------
# Clave maestra para autenticación de endpoints administrativos de backend
MASTER_API_KEY=cambiar_por_clave_maestra_alta_entropia_64chars

# Clave secreta para firma de tokens JWT (RBAC de 4 niveles)
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=cambiar_por_secreto_jwt_de_minimo_32_caracteres_aleatorios
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Orígenes permitidos para CORS (Cross-Origin Resource Sharing)
ALLOWED_ORIGINS=["*"]

# -----------------------------------------------------------------------------
# 4. INTEGRACIONES EXTERNAS (Meteorología y Notificaciones)
# -----------------------------------------------------------------------------
# OpenWeatherMap API Key (Obtener en: https://openweathermap.org/api)
OPENWEATHER_API_KEY=tu_api_key_de_openweathermap_aqui

# Proveedor de Alertas Rurales ('meta_cloud' para WhatsApp oficial o 'mock' para pruebas)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=tu_meta_whatsapp_cloud_api_token_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_de_whatsapp_aqui

# Fallback Offline por Módem GSM/GPRS
ENABLE_SIM800L_EDGE_SMS=true

# -----------------------------------------------------------------------------
# 5. GRAFANA (Visualización y Gemelo Virtual)
# -----------------------------------------------------------------------------
# Usuario y contraseña del administrador de Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_grafana_admin_password_2026
GRAFANA_ALLOW_SIGNUP=false
GRAFANA_PORT=3000

# -----------------------------------------------------------------------------
# 6. PUERTOS Y FRONTEND (React SPA + Nginx)
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
WEBAPP_PORT=80
VITE_API_URL=/api/v1
VITE_GRAFANA_URL=http://localhost:3000
