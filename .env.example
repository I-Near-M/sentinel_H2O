# =========================================================================
# SENTINEL-H2O — CONFIGURACIÓN DE ENTORNO Y PRODUCCIÓN DOCKER
# =========================================================================

# -------------------------------------------------------------------------
# 1. BASE DE DATOS MYSQL 8.0 (Schema 3.0 Normalizado)
# -------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=sentinel_root_secret_2026
MYSQL_DATABASE=sentinel_h2o_db
MYSQL_USER=sentinel_user
MYSQL_PASSWORD=sentinel_db_password_2026
MYSQL_PORT=3306

# Cadena de Conexión interna de Docker (Backend -> MySQL)
DATABASE_URL=mysql+pymysql://sentinel_user:sentinel_db_password_2026@sentinel-db:3306/sentinel_h2o_db

# -------------------------------------------------------------------------
# 2. PUERTOS Y HOSTING DE SERVICIOS
# -------------------------------------------------------------------------
WEBAPP_PORT=80
BACKEND_PORT=8000
TZ=America/Lima
ENV=production

# -------------------------------------------------------------------------
# 3. SEGURIDAD & TOKENS DE ACCESO (Cambiar en despliegues reales)
# -------------------------------------------------------------------------
MASTER_API_KEY=sentinel_master_key_chancay_2026_secure
JWT_SECRET_KEY=sentinel_production_jwt_secret_key_2026_secure_32bytes
ALLOWED_ORIGINS=["*"]

# -------------------------------------------------------------------------
# 4. DATOS INICIALES Y SEMILLEROS
# -------------------------------------------------------------------------
# false: Inicia 100% limpio (0 nodos) para configurar la cuenca con el Setup Wizard en la web.
# true:  Siembra automáticamente las 8 estaciones hidrométricas de demostración de Chancay-Huaral.
SEED_DEMO_DATA=false

# -------------------------------------------------------------------------
# 5. INTEGRACIONES EXTERNAS (Opcionales)
# -------------------------------------------------------------------------
# Proveedor meteorológico OpenWeather (obtener en https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Notificaciones WhatsApp ('mock' para pruebas locales, 'meta_cloud' para producción)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
