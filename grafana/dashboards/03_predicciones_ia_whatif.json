      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT n.nombre AS Estacion, n.sector_cuenca AS Sector, n.cota_msnm AS Cota_msnm, COALESCE(ROUND(p_avg.avg_caudal, 2), 0.0) AS Caudal_Medio_24h, COALESCE(ROUND(p_avg.avg_wqi, 1), 75.0) AS WQI_Medio_24h, COALESCE(p_latest.riesgo_estres_hidrico, 'BAJO') AS Riesgo_24h FROM nodos n LEFT JOIN (SELECT p.id_nodo, AVG(p.caudal_predicho_m3s) AS avg_caudal, AVG(p.wqi_predicho) AS avg_wqi FROM predicciones_ia p INNER JOIN (SELECT id_nodo, MAX(fecha_emision) AS max_fem FROM predicciones_ia GROUP BY id_nodo) latest ON p.id_nodo = latest.id_nodo AND p.fecha_emision = latest.max_fem GROUP BY p.id_nodo) p_avg ON n.id_nodo = p_avg.id_nodo LEFT JOIN (SELECT p1.id_nodo, p1.riesgo_estres_hidrico FROM predicciones_ia p1 INNER JOIN (SELECT id_nodo, MAX(id_prediccion) AS max_id FROM predicciones_ia GROUP BY id_nodo) p2 ON p1.id_prediccion = p2.max_id) p_latest ON n.id_nodo = p_latest.id_nodo WHERE n.activo = 1 ORDER BY n.cota_msnm DESC;",
          "refId": "A"
        }
      ],
      "title": "🗺️ Matriz Hidrológica y Semáforo Predictivo 24h por Estación (Cabecera a Valle)",
