      },
      "id": 10,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT n.nombre AS estacion, n.id_nodo, n.sector_cuenca, n.cota_msnm, r.battery_v, r.signal_rssi, CASE WHEN r.battery_v >= 12.4 THEN 'Batería Óptima (Solar)' WHEN r.battery_v >= 11.8 THEN 'Batería Normal' ELSE 'Batería Baja / Alerta' END AS estado_energetico, r.timestamp_servidor AS ultimo_paquete FROM nodos n INNER JOIN (SELECT id_nodo, MAX(timestamp_servidor) AS max_t FROM mediciones_raw GROUP BY id_nodo) latest ON n.id_nodo = latest.id_nodo INNER JOIN mediciones_raw r ON latest.id_nodo = r.id_nodo AND latest.max_t = r.timestamp_servidor WHERE n.activo = 1 ORDER BY n.cota_msnm DESC;",
          "refId": "A"
        }
      ],
      "title": "Diagnóstico de Hardware y Telemetría Solar por Estación",
      "type": "table"
    },
