        {
          "format": "table",
          "rawSql": "SELECT n.latitud AS latitude, n.longitud AS longitude, n.nombre AS Estacion, n.id_nodo AS ID_Nodo, n.cota_msnm AS Cota_msnm, COALESCE((SELECT p.ph FROM mediciones_procesadas p WHERE p.id_nodo = n.id_nodo ORDER BY p.timestamp DESC LIMIT 1), 0) AS pH, COALESCE((SELECT p.wqi_score FROM mediciones_procesadas p WHERE p.id_nodo = n.id_nodo ORDER BY p.timestamp DESC LIMIT 1), 0) AS WQI_Score, COALESCE((SELECT p.wqi_categoria FROM mediciones_procesadas p WHERE p.id_nodo = n.id_nodo ORDER BY p.timestamp DESC LIMIT 1), 'N/A') AS WQI_Estado, COALESCE((SELECT p.ec_us_cm FROM mediciones_procesadas p WHERE p.id_nodo = n.id_nodo ORDER BY p.timestamp DESC LIMIT 1), 0) AS EC_Salinidad_uS_cm, COALESCE((SELECT p.turbidez_ntu FROM mediciones_procesadas p WHERE p.id_nodo = n.id_nodo ORDER BY p.timestamp DESC LIMIT 1), 0) AS Turbidez_NTU, COALESCE((SELECT p.caudal_m3s FROM mediciones_procesadas p WHERE p.id_nodo = n.id_nodo ORDER BY p.timestamp DESC LIMIT 1), 0) AS Caudal_m3s, COALESCE((SELECT p.tirante_agua_cm FROM mediciones_procesadas p WHERE p.id_nodo = n.id_nodo ORDER BY p.timestamp DESC LIMIT 1), 0) AS Tirante_cm, COALESCE((SELECT p.temp_agua_c FROM mediciones_procesadas p WHERE p.id_nodo = n.id_nodo ORDER BY p.timestamp DESC LIMIT 1), 0) AS Temp_Agua_C FROM nodos n WHERE n.activo = 1;",
