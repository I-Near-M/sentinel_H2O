          "rawSql": "SELECT n.cota_msnm, n.nombre AS estacion, n.sector_cuenca, n.tipo_fuente, p.caudal_m3s, p.ph, p.ec_us_cm, p.turbidez_ntu, p.temp_agua_c, p.wqi_score, p.wqi_categoria, p.timestamp AS ultima_lectura FROM nodos n INNER JOIN (SELECT id_nodo, MAX(timestamp) AS max_t FROM mediciones_procesadas GROUP BY id_nodo) latest ON n.id_nodo = latest.id_nodo INNER JOIN mediciones_procesadas p ON latest.id_nodo = p.id_nodo AND latest.max_t = p.timestamp WHERE n.activo = 1 ORDER BY n.cota_msnm DESC;",
